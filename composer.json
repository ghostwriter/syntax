{
    "name": "ghostwriter/syntax",
    "description": "Lexical Analysis library for PHP",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "generator",
        "ghostwriter",
        "lexer",
        "parser",
        "syntax",
        "tokenizer"
    ],
    "authors": [
        {
            "name": "Nathanael Esayeas",
            "email": "nathanael.esayeas@protonmail.com",
            "homepage": "https://github.com/ghostwriter",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/ghostwriter/syntax",
    "support": {
        "issues": "https://github.com/ghostwriter/syntax/issues",
        "forum": "https://github.com/ghostwriter/syntax/discussions",
        "source": "https://github.com/ghostwriter/syntax",
        "docs": "https://github.com/ghostwriter/syntax",
        "rss": "https://github.com/ghostwriter/syntax/releases.atom",
        "security": "https://github.com/ghostwriter/syntax/security/advisories/new"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/ghostwriter"
        },
        {
            "type": "paypal",
            "url": "https://paypal.me/codepoet"
        }
    ],
    "_comment": [
        "#BlackLivesMatter",
        "#FreePalestine",
        "#StandWithIran",
        "#StandWithUkraine",
        "#StopGenocide"
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0 || ~8.6.0",
        "ext-mbstring": "*",
        "ghostwriter/case-converter": "^2.2.2",
        "ghostwriter/collection": "^2.1.1",
        "ghostwriter/container": "^7.0.2",
        "ghostwriter/event-dispatcher": "^6.1.3",
        "ghostwriter/json": "^3.0.3",
        "ghostwriter/option": "^2.0.0",
        "ghostwriter/result": "^2.0.0"
    },
    "require-dev": {
        "ext-xdebug": "*",
        "boundwize/structarmed": "^0.16.30",
        "ghostwriter/coding-standard": "dev-main",
        "ghostwriter/phpunit-assertions": "^0.1.1",
        "mockery/mockery": "^1.6.15",
        "phpunit/phpunit": "^13.3.2"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Ghostwriter\\Syntax\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Unit\\": "tests/Unit/"
        },
        "files": [
            "tests/bootstrap.php"
        ],
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "bin": [
        "bin/syntax"
    ],
    "config": {
        "allow-plugins": {
            "ghostwriter/coding-standard": true
        },
        "bump-after-update": false,
        "classmap-authoritative": false,
        "discard-changes": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.999"
        },
        "policy": {
            "advisories": {
                "block": true,
                "audit": "fail"
            },
            "malware": {
                "block": true,
                "block-scope": "all",
                "audit": "fail"
            },
            "abandoned": {
                "block": true,
                "audit": "fail"
            }
        },
        "preferred-install": {
            "*": "dist"
        },
        "prepend-autoloader": true,
        "process-timeout": 5000,
        "sort-packages": true,
        "strict-psr-autoloader": true,
        "use-parent-dir": false
    },
    "extra": {
        "thanks": {
            "name": "ghostwriter/syntax",
            "url": "https://github.com/ghostwriter/syntax"
        }
    },
    "scripts": {
        "cache:clear": "rm -rf ./.cache/*",
        "check": [
            "@cache:clear",
            "@composer validate",
            "@test"
        ],
        "infection": [
            "@xdebug",
            "infection --min-covered-msi=0 --min-msi=0 --show-mutations --threads=max"
        ],
        "phpunit": [
            "@xdebug",
            "phpunit --colors=always"
        ],
        "test": [
            "@phpunit",
            "@infection"
        ],
        "xdebug": "@putenv XDEBUG_MODE=coverage"
    }
}
